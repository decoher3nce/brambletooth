# Brambletooth environment template. Copy to .env.local and fill in
# values that are specific to YOUR deployment. .env.local is
# gitignored — values you put there never reach the repo.

# Bare short-name of the reverse-proxy gateway host that serves
# https://<PUBLIC_HOST>/brambletooth/. Used only by vite.config.ts
# to extend the dev server's allowedHosts so the dev URL works
# when proxied. The runtime client reads `location.host` at the
# browser, so this var does NOT need to ship to the client bundle.
#
# Example values: "gateway", "homelab", a Tailscale short-name, etc.
PUBLIC_HOST=
